                <place_name BNE="" BNE_city="" BNF="" BNF_city="" GND="" GND_city="" GS_Klosterdatenbank="" Getty="" LCCN="" LCCN_city="" VIAF="" VIAF_city="" addition="" category="Kanonikerstift" country="Frankreich" diocese="Arvernum" geo_DEZIMAL_city="" geo_DMS_city="N 45°17′39″ E 3°23′03″" geodata="N 45°17′37″ E 3°23′05″" geodata_region="0" geodata_vague="0" geonames_city="3029995" getty_city="" id="12276990" identification="Brioude, Chapitre Saint-Julien" institution="ecclesia S. Iuliani Brivatensis" literature="" region="Auvergne-Rhône-Alpes" uuid="{EF0169CD-54F8-4821-9E5B-E65FB1405BEE}">Brivatenses</place_name> certis temporibus, scil. In 
