                <pers_name addition="von Nursia" floruit="480-547" key="100179656" life="ca. 480-547" literature="PCBE 2/1, S. 285, Benedictus 3" place="Monte Cassino" reg="s. Benedictus abbas" sex="male" termofoffice="529-547" uuid="{294D6222-78C5-43E6-B90A-3994DF3B4D9F}">b. Benedicti</pers_name> regulam et institutionem Cartusiensium fratrum observando.</pont_reg_main>
