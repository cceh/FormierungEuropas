                    <adressee> Roberto priori</adressee> </pers_name>
                <place_name BNE="" BNE_city="" BNF="" BNF_city="" GND="" GND_city="" GS_Klosterdatenbank="" Getty="" LCCN="" LCCN_city="" VIAF="" VIAF_city="" addition="OCart, heute eine Ruine" category="Kloster" country="Frankreich" diocese="Vivarium" geo_DEZIMAL_city="" geo_DMS_city="N 44°50′57″ E 4°07′08″" geodata="N 44°52′17″ E 4°10′38″" geodata_region="0" geodata_vague="0" geonames_city="3005334" getty_city="" id="12470220" identification="La Chatreuse de Bonnefoy" institution="Monasterium S. Mariae Bonae Fidei" literature="" region="Auvergne-Rhône-Alpes" uuid="{0C83F1A1-72CE-46A9-B6C3-7B4FB05967C9}">
