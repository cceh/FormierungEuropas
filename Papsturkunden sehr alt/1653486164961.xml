                    <adressee> Nicolao</adressee> </pers_name>) 
                <place_name category="Bistum" country="Frankreich" diocese="Vivarium" geo_DEZIMAL_city="44.4828, 4.68895" geo_DMS_city="N 44°28′58″ E 4°41′20″" geodata="N 44°28′55″ E 4°41′25″" geodata_region="-1" geodata_vague="0" geonames_city="2967820" id="12047232" identification="Viviers, episc." institution="Episcopatus Vivariensis" region="Auvergne-Rhône-Alpes" uuid="{02075C7B-A0E6-44CE-B120-62F8DE2FC7BA}">
                    <adressee> Vivariensi</adressee> </place_name> episcopis: scribit priorem et fratres 
                <place_name BNE="" BNE_city="" BNF="" BNF_city="" GND="" GND_city="" GS_Klosterdatenbank="" Getty="" LCCN="" LCCN_city="" VIAF="" VIAF_city="" addition="OCart, heute eine Ruine" category="Kloster" country="Frankreich" diocese="Vivarium" geo_DEZIMAL_city="" geo_DMS_city="N 44°50′57″ E 4°07′08″" geodata="N 44°52′17″ E 4°10′38″" geodata_region="0" geodata_vague="0" geonames_city="3005334" getty_city="" id="12470220" identification="La Chatreuse de Bonnefoy" institution="Monasterium S. Mariae Bonae Fidei" literature="" region="Auvergne-Rhône-Alpes" uuid="{0C83F1A1-72CE-46A9-B6C3-7B4FB05967C9}">Bonae Fidei</place_name> sibi significavisse quod a quibusdam in eorum episcopatibus constitutis super decimis laborum et nutrimentorum animalium contra tenorem privilegii Cartusiensi ordini indulti (
                <data_link col_id="1006" id="1653486163430">Gall. Pont. III,3 325 n. 1 </data_link>) fatigantur. Unde eis mandat quatinus sub suspensionis vel excommunicationis sententia prohibeant ne quis a fratribus 
                <place_name BNE="" BNE_city="" BNF="" BNF_city="" GND="" GND_city="" GS_Klosterdatenbank="" Getty="" LCCN="" LCCN_city="" VIAF="" VIAF_city="" addition="OCart, heute eine Ruine" category="Kloster" country="Frankreich" diocese="Vivarium" geo_DEZIMAL_city="" geo_DMS_city="N 44°50′57″ E 4°07′08″" geodata="N 44°52′17″ E 4°10′38″" geodata_region="0" geodata_vague="0" geonames_city="3005334" getty_city="" id="12470220" identification="La Chatreuse de Bonnefoy" institution="Monasterium S. Mariae Bonae Fidei" literature="" region="Auvergne-Rhône-Alpes" uuid="{0C83F1A1-72CE-46A9-B6C3-7B4FB05967C9}">Bonae Fidei</place_name> vel aliis Cartusiensis ordinis decimas extorqueat.</pont_reg_main>
