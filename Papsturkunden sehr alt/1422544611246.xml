<text id="1422544611246" type="charter"><info><idno>Ib. Pont. I 69 n. 110</idno><date_sort value="11631113">11631113</date_sort></info><head><criteria/><supplier><pers_name key="88956811" life="1181" place="Roma" reg="Alexander III papa (Rolandus Bandinelli )">Alexander III</pers_name></supplier><supplier_type>papa</supplier_type><pub_place><place_name diocese="Sens" geodata="N 48°12′00″ E 3°17′00″" identification="Sens">Sens</place_name></pub_place><date_p to="11631113" value="11631113">(1163) nov. 13</date_p><worker>Berger</worker></head><jaffe><jaffe2_worker>-</jaffe2_worker><jaffe2_no>-</jaffe2_no></jaffe><pont><receipt_inst><pont_reg_add nr="Ib. Pont. I 69 n. 110">Burgos, Episc.; confer Ib. Pont I Burgos, Episc. n. 112.; Vide Ib. Pont. Sigüenza, Episc.; vide etiam Ib. Pont. Toledo, Archiepisc.; Ib. Pont. Zamora, Episc.; Ib. Pont. Osma, Episc.</pont_reg_add></receipt_inst><pont_bd><pont_reg_add nr="Ib. Pont. I 69 n. 110">Ib. Pont. I</pont_reg_add></pont_bd><pont_no><pont_reg_add nr="Ib. Pont. I 69 n. 110">69 n. 110</pont_reg_add></pont_no><pontificate>Alexander III.</pontificate><regest_pont><pont_reg_add nr="Ib. Pont. I 69 n. 110"><pers_name key="88956811" life="1181" place="Roma" reg="Alexander III papa (Rolandus Bandinelli )"><issuer>Alexander III</issuer></pers_name><pers_name addition="de Segovia" life="1166" place="Toledo" reg="Iohannes archiepiscopus"><adressee>Iohanni</adressee></pers_name><place_name category="archiepiscopatus" diocese="Toledo" geodata="N 39°51′29″ W 4°01′21″" identification="Toledo, archiepisc." institution="Archiepiscopatus Toletanus"><adressee>Toletano</adressee></place_name> archiepiscopo et <pers_name addition="Esteban" life="Bischof bis 1174" place="Zamora" reg="Stephanus episcopus"><adressee>Stephano</adressee></pers_name><place_name category="episcopatus" diocese="Zamora" geodata="N 41°30′23″ W 5°44′40″" identification="Zamora, episc." institution="Episcopatus Zamorensis"><adressee>Zamorensi</adressee></place_name> ac <pers_name addition="Perez" life="Bischof bis 1181" place="Burgos" reg="Petrus (II) episcopus"><adressee>P(etro II)</adressee></pers_name><place_name category="episcopatus" diocese="Burgos" geodata="N 42°21′01″ W 3°40′31″" identification="Burgos, episc." institution="Episcopatus Burgensis"><adressee>Burgensi</adressee></place_name> episcopis: litteris eorum et aliorum episcoporum Hispanorum (Burgos, Episc. n. *109) cognitis mandat, ut episcopum <place_name category="episcopatus" diocese="Osma" geodata="N 41°35′10″ W 3°03′55″" identification="El Burgo de Osma, episc." institution="Episcopatus Oxomensis">Oxomensem</place_name> infra viginti dies post harum susceptionem ante suam praesentiam evocent super quibusdam excessibus canonice responsurum, significans, quod <place_name category="episcopatus" diocese="Osma" geodata="N 41°35′10″ W 3°03′55″" identification="El Burgo de Osma, episc." institution="Episcopatus Oxomensis">Oxomensis</place_name> episcopus, cum in <place_name category="episcopatus" diocese="Siguenza" geodata="N 41°04′08″ W 2°38′35″" identification="Siguenza, episc" institution="Episcopatus Seguntinus">Seguntina</place_name> dioecesi plurimas violentias perpetravisset, nec ad praesentiam archiepiscopi <place_name category="archiepiscopatus" diocese="Toledo" geodata="N 39°51′29″ W 4°01′21″" identification="Toledo, archiepisc." institution="Archiepiscopatus Toletanus">Toletani</place_name>, qui eum ex mandato apostolico super hiis evocavisset, venit nec ablata reddidit, verum etiam villam nomine <place_name diocese="Siguenza" geodata="N 41°29′11″ W 2°31′51″" identification="Almazan">Almazam</place_name> (<place_name diocese="Siguenza" geodata="N 41°29′11″ W 2°31′51″" identification="Almazan">Almazán</place_name>) ad <place_name category="episcopatus" diocese="Siguenza" geodata="N 41°04′08″ W 2°38′35″" identification="Siguenza, episc" institution="Episcopatus Seguntinus">Segontinum</place_name> episcopum pertinentem occupavit; mandat, ut episcopus <place_name category="episcopatus" diocese="Osma" geodata="N 41°35′10″ W 3°03′55″" identification="El Burgo de Osma, episc." institution="Episcopatus Oxomensis">Oxomensis</place_name>, si in praesentiam iudicum delegatorum venire contempserit vel se purgare non potuerit, auctoritate apostolica ab omni pontificali officio suspendatur; insuper si praefatam villam et ceteras sibi occupatas infra triginta dies post commonitionem episcopo <place_name category="episcopatus" diocese="Siguenza" geodata="N 41°04′08″ W 2°38′35″" identification="Siguenza, episc" institution="Episcopatus Seguntinus">Seguntino</place_name> non reddiderit, ipsi iudices <place_name category="episcopatus" diocese="Siguenza" geodata="N 41°04′08″ W 2°38′35″" identification="Siguenza, episc" institution="Episcopatus Seguntinus">Seguntinum</place_name> in possessionem reducant aut, si non potuerint, <place_name category="episcopatus" diocese="Osma" geodata="N 41°35′10″ W 3°03′55″" identification="El Burgo de Osma, episc." institution="Episcopatus Oxomensis">Oxomensem</place_name> episcopum publice excommunicatum enuntient.</pont_reg_add></regest_pont><main_comment_pont><pont_reg_add nr="Ib. Pont. I 69 n. 110">De re v. etiam litteras <pers_name key="88956811" life="1181" place="Roma" reg="Alexander III papa (Rolandus Bandinelli )">Alexandri III</pers_name>, quas eodem anno <date value="11631121">nov. 21</date> regi <pers_name key="192898432" life="1188" place="Leon, Galicia" reg="Ferdinandus II rex">Fredinando II</pers_name> direxit (ed. <bibl_link target="Minguella y Arnedo, Diócesis de Sigüenza">Minguella y Arnedo Historia I</bibl_link> 412 n. 57) nec non eas, quas a. <date value="11640622">1164 iun. 22</date> eisdem iudicibus delegatis episcopo <place_name category="episcopatus" diocese="Leon" geodata="N 42°36′00″ W 5°34′13″" identification="Leon, episc." institution="Episcopatus Legionensis">Legionensi</place_name> addito misit (Burgos, Episc. n. 112). Cf. <bibl_link target="Serrano, Obispado de Burgos">Serrano Obispado de Burgos</bibl_link> II 104; <bibl_link target="González, Alfonso VIII">González Reino</bibl_link> I 368sq. Episcopus <place_name category="episcopatus" diocese="Osma" geodata="N 41°35′10″ W 3°03′55″" identification="El Burgo de Osma, episc." institution="Episcopatus Oxomensis">Oxomensis</place_name> vituperabatur, quod praeter villam <place_name diocese="Siguenza" geodata="N 41°29′11″ W 2°31′51″" identification="Almazan">Almazam</place_name> has villas iniuste occupaverat: Ayllon, <place_name diocese="Siguenza" geodata="N 41°23′00″ W 3°05′29″" identification="Caracena">Caracena</place_name>, <place_name diocese="Siguenza" geodata="N 38°17′00″ W 5°49′00″" identification="Berlanga de Duero">Berlanga</place_name>, cf. Burgos, Episc. n. 112.</pont_reg_add></main_comment_pont><worker_comment_pont><pont_reg_add nr="Ib. Pont. I 69 n. 110">Adressaten: Iohanni Toletano archiepiscopo et Stephano Zamorensi ac <pers_name addition="Perez" life="Bischof bis 1181" place="Burgos" reg="Petrus (II) episcopus">P(etro II</pers_name>) Burgensi episcopis. Anmerkungen und to do: ; Personen: <pers_name key="88956811" life="1181" place="Roma" reg="Alexander III papa (Rolandus Bandinelli )">Alexander III</pers_name>., Papst, Juan (II.), Ebf. v. Toledo, Estebán, Bf. v. Zamora, <pers_name addition="Pedro de Agen" life="1149" place="Segovia" reg="Petrus episcopus">Pedro</pers_name> (II.), Bf. v. Burgos, Osma, Bf., Fernando (II.), Kg. v. León (Komm.); León, Bf. (Komm.); Orte: Osma, Sigüenza, Almazán, Ayllón (Komm.), Caracena (Komm.)</pont_reg_add></worker_comment_pont></pont><descent><descent_type/></descent><bibl><mention>0</mention><edition><bibl_link target="Minguella y Arnedo, Diócesis de Sigüenza">Minguella y Arnedo Historia I</bibl_link> 406 n. 50</edition></bibl></text>