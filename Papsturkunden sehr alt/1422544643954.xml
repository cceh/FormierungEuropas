    <pont>
        <main_comment_pont>
            <pont_reg_main nr="Ib. Pont. I 141 n. 35">Huius chartae bipartitae pars una in archivo 
                <place_name addition="OSB" category="monasterium" diocese="Burgos" geodata="N 42°44′02″ W 3°24′53″" identification="Ona, San Salvador" institution="Monasterium s. Salvatoris Oniense">Oniensi</place_name> (nunc in Archivo Historico Nationali Matritensi [AHN] asservato), pars altera in archivo 
                <place_name addition="OSB" category="monasterium" diocese="Calahorra" geodata="N 42°19′47″ W 2°51′43″" identification="San Millan de la Cogolla" institution="Monasterium s. Aemiliani">monasterii s. Aemiliani</place_name> tradita est. De scriptore, subscriptione cardinalis 
                <pers_name addition="Giacinto Bobone" key="193550312" life="1198" place="Roma" reg="Coelestin III papa (Hyacintus Bobo)">Iacinti</pers_name> sigilloque eiusdem, quod de utraque parte pependit, cf. adnotationes apud 
                <bibl_link target="Papsturkunden in Spanien 1">Kehr Papsturkunden Spanien I</bibl_link> 464. De re cf. 
                <bibl_link target="Serrano, Cartulario de San Millán">Serrano Cartulario de San Millán</bibl_link> p. LXXXVIIsq. Laudatur haec charta insuper apud 
                <bibl_link target="Fita, Canonización">Fita Canonización</bibl_link> p. 108; 
                <bibl_link target="Säbekow, Legationen">Säbekow Legationen</bibl_link> p. 54; 
                <bibl_link target="Serrano, Obispado de Burgos">Serrano Obispado de Burgos</bibl_link> II 108sq.; 
                <bibl_link target="González, Alfonso VIII">González Reino</bibl_link> I 380; 
                <bibl_link target="Smith, Iberian Legations">Smith Iberian Legations</bibl_link> p. 87. De decimis in villa de 
                <place_name diocese="Burgos" geodata="N 42°36′10″ W 3°04′38″" identification="Altable">Artable</place_name> saec. XIII rursum quaestio inter monasterium 
                <place_name addition="OSB" category="monasterium" diocese="Burgos" geodata="N 42°44′02″ W 3°24′53″" identification="Ona, San Salvador" institution="Monasterium s. Salvatoris Oniense">Oniense</place_name> et clericos eiusdem villae agitata est. Super hac controversia denique compositio episcopo 
                <place_name category="episcopatus" diocese="Burgos" geodata="N 42°21′01″ W 3°40′31″" identification="Burgos, episc." institution="Episcopatus Burgensis">Burgensi</place_name> mediante intercessit, quam 
                <pers_name key="100162520" life="1254" place="Roma" reg="Innocentius IV papa (Sinibaldus de Flesco)">Innocentius IV</pers_name> a. 
                <date value="12470209">1247 febr. 9</date> roboravit (ed. 
                <bibl_link target="Fita, Canonización">Fita Canonización</bibl_link> p. 120 n. 16; 
                <bibl_link target="Álamo, Colección Oña">Álamo Colección Oña</bibl_link> II 623sq. n. 508).</pont_reg_main>
            <pont_reg_add nr="Ib. Pont. II 36 n. 75"> Paulo antea, a. 1173 oct. 19, praesens in villa 
                <place_name addition="OSB" category="Kloster" diocese="Legio" geodata="N 42°22′15″ W 5°01′46″" id="3111131" identification="Sahagun, Monasterium s. Facundi" institution="Monasterium s. Facundi">Sancti Facundi (Sahagún)</place_name>, 
                <pers_name addition="Giacinto Bobone" key="193550312" life="gest. 1198" place="Roma" reg="Coelestinus III papa (Hyacintus Bobo)">cardinalis Iacintus</pers_name> misit litteram 
                <place_name addition="OPraem" category="Kloster" diocese="Burgos" geodata="N 42°47′40″ W 4°15′32″" id="3130824" identification="Santa Maria de Aguilar de Campoo" institution="Monasterium s. Mariae Regalis de Aguilar">monasterio de Aguilar de Campoo</place_name>. Cf. Santa María de Aguilar de Campoo n. 1 (
                <bibl_link target="Berger, Iberia pontificia 1">Ib. Pont. I</bibl_link> 163). Praeterea, eodem mense oct. 
                <pers_name addition="Giacinto Bobone" key="193550312" life="gest. 1198" place="Roma" reg="Coelestinus III papa (Hyacintus Bobo)">cardinalis Iacintus</pers_name>, praesens in dicta villa 
                <place_name addition="OSB" category="Kloster" diocese="Legio" geodata="N 42°22′15″ W 5°01′46″" id="3111131" identification="Sahagun, Monasterium s. Facundi" institution="Monasterium s. Facundi">Sancti Facundi</place_name>, misit litteras clericis 
                <place_name category="Stadt" diocese="Palencia" geodata="N 41°39′19″ W 4°43′25″" id="3106672" identification="Valladolid">Vallis Oletim (Valladolid</place_name>) et 
                <place_name addition="San Xulián y Basilisa de Samos" category="Kloster" geodata="N 42° 44′ 0″ W 7° 18′ 0″" identification="Monasterio de San Julián de Samos">monasterio de Samos</place_name>. Cf. 
                <bibl_link target="Weiß, Legaten">Weiß Legaten</bibl_link> p. 187 n. 39.</pont_reg_add>
        </main_comment_pont>
