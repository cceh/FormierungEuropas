    <pont>
        <main_comment_pont>
            <pont_reg_main nr="Gall. Pont. III,3 318 n. 1">Le contexte historique de l’acquisition de ce privilège, par ailleurs classique, mérite attention. 
                <pers_name floruit="1163-1173" literature="Gallia christiana XVI, Sp. 607" place="Les Chambons" reg="Guillelmus I abbas" sex="male" termofoffice="1163 belegt - 1173 belegt" uuid="{49027E42-EAE0-4911-8982-869FBA2DD19E}"> L’abbé Guillaume</pers_name> l’obtint à la veille de la paix de 
                <place_name GND_city="4062501-1" LCCN_city="n79018142" VIAF_city="136651400" category="Stadt" country="Italien" diocese="Venetiae" geo_DMS_city="N 45° 26′ 0″ E 12° 20′ 0″" geodata="N 45°26′15″ E 12°20′9″" geodata_region="0" geodata_vague="0" id="3164603" identification="Venezia" institution="Civitas Venetia" region="Venetien" uuid="{E9ACF877-04B5-4C0C-AF6B-44EDA5841005}">Venise</place_name> à laquelle 
                <pers_name addition="Robert de La Tour du Pin, zuvor Bf. v. Viviers (1171-1172/73)" floruit="1171-1195" literature="Gallans, Deux archevêchés, S. 87f., 89-111" place="Vienne" reg="Robertus archiepiscopus" sex="male" termofoffice="1173 belegt - 1195 belegt" uuid="{E03ACA95-9359-4109-A819-C4C3CFD205A7}">l’archevêque Robert</pers_name> de 
                <place_name GND_city="4119422-6" LCCN_city="n80139195" VIAF_city="152049885" category="Erzbistum" country="Frankreich" diocese="Vienna" geo_DEZIMAL_city="45.525833°, 4.874722°" geo_DMS_city="N 45° 31′ 33″ E 4° 52′ 29″" geodata="N 45°31′27″ E 4°52′23″" geodata_region="-1" geodata_vague="0" id="12042115" identification="Vienne, archiepisc." institution="Archiepiscopatus Viennensis" region="Auvergne-Rhône-Alpes" uuid="{A455AF61-5A74-42DB-8B56-D1F7671DBD76}">Vienne</place_name> ainsi que l’abbé cistercien de 
                <place_name VIAF_city="248738316" addition="OCist" category="Kloster" country="Frankreich" diocese="Vienna" geo_DMS_city="N 46° 27′ 49″ E 0° 13′ 51″" geodata="N 44°27′22″ E 5°09′19″" geodata_region="0" geodata_vague="0" id="11049336" identification="Abbaye Notre Dame de Bonnevaux" institution="Abbatia Bonae Vallis" region="Nouvelle-Aquitaine" uuid="{D2B612FC-07D9-444C-B03C-7350B124932E}">Bonnevaux (diocèse de Vienne)</place_name> et 
                <pers_name addition="Thierry" floruit="1167-1205" life="gest. 1205" literature="Gall. Pont. III,1, S. 327-331." place="La Sylve-Bénite" reg="Theodericus prior" sex="male" termofoffice="1167 belegt - 1205" uuid="{1AFCA552-AA80-408E-A68B-CCD9C1F431AC}">le Chartreux Thierry</pers_name> de 
                <place_name addition="OCart, auch La Silve-Bénite" category="Kloster" country="Frankreich" diocese="Vienna" geo_DMS_city="N 45°28′16″ E 5°32′06″" geodata="N 45°26′44″ E 5°28′58″" geodata_region="0" geodata_vague="0" geonames_city="12055883" id="12276976" identification="Chartreuse de la Sylve-Benite" institution="Silva Benedicta" region="Auvergne-Rhône-Alpes" uuid="{02B3665C-6EA5-43ED-A6D1-3C0770AB38E2}">La Silve-Bénite (diocèse de Vienne)</place_name> collaborèrent; voir 
                <bibl_link target="Gallia pontificia 3, 1" target2="1340743" uuid="{CA574245-0327-4FDE-B99B-819FA98DC6FC}">Gall. Pont. III,1</bibl_link>, 189 n. *312, 321 n. *18–*19, 328 n. *1–*2. Le privilège en faveur des 
                <place_name BNE="" BNE_city="" BNF="" BNF_city="" GND="" GND_city="" GS_Klosterdatenbank="" Getty="" LCCN="" LCCN_city="" VIAF="" VIAF_city="" addition="OCist; die Steine der Abtei wurden später für den Bau der Häuser in Les Chambons verwendet" category="Kloster" country="Frankreich" diocese="Vivarium" geo_DEZIMAL_city="" geo_DMS_city="N 45°06′00″ E 3°47′56″" geodata="N 44°37′43″ E 4°03′10″" geodata_region="0" geodata_vague="0" geonames_city="3031520" getty_city="" id="112470219" identification="Abbaye des Chambons" institution="Monasterium S. Mariae de Campis bonis" literature="" region="Auvergne-Rhône-Alpes" uuid="{DA0A235D-FEC2-4885-823B-768FDA883A9C}">Chambons</place_name> serait-il à rapprocher des deux lettres de 
                <pers_name BNF="12488571m" GND="118535757" LCCN="n50047907" Wikidata="Q79789" addition="Barbarossa" floruit="1122-1190" key="29635765" life="1122-1190" place="regnum et imperium" reg="Fridericus I imperator" sex="male" termofoffice="1152-1190" uuid="{A865BE60-9B2E-48E0-9421-C874C75DE67B}">Frédéric Barberousse</pers_name> adressées à 
                <pers_name addition="de Châteauneuf, Abt von Léoncel (1162-66) und Bonnevaux (1166-um 1194)" floruit="1142-1194" key="316732546" life="ca. 1120 - nach 1194" literature="Gall. Pont. III,3, S. 113; Dictionnaire d'histoire et de géographie ecclésiastiques 26, Sp. 194f." place="Bonnevaux" reg="s. Hugo abbas" sex="male" termofoffice="1166 - 1194 belegt" uuid="{B14C8117-08D7-4F1D-AE6A-D7F985F0DE3C}">Hugues</pers_name> de 
                <place_name VIAF_city="248738316" addition="OCist" category="Kloster" country="Frankreich" diocese="Vienna" geo_DMS_city="N 46° 27′ 49″ E 0° 13′ 51″" geodata="N 44°27′22″ E 5°09′19″" geodata_region="0" geodata_vague="0" id="11049336" identification="Abbaye Notre Dame de Bonnevaux" institution="Abbatia Bonae Vallis" region="Nouvelle-Aquitaine" uuid="{D2B612FC-07D9-444C-B03C-7350B124932E}">Bonnevaux</place_name> et dont l’une invitait l’abbé à participer à des négociations avec le pape à partir de la fête de saint Michel (29 septembre) 1176 (
                <bibl_link target="MGH DD FI" target2="47488" uuid="{5C8EF513-CDC3-4F1B-91C4-DC480CB17E4A}">M. G. H., Dipl. Frédéric Ier</bibl_link>, nos 654–655; 
                <bibl_link target="RI IV, 2,3" target2="117717" uuid="{2E4B3EB7-6B29-4324-9093-54C9AB532A4B}">Böhmer-Opll</bibl_link>, nos 2192–2193, p. 133; 
                <bibl_link target="Chevalier, Regeste Dauphinois" target2="48077" uuid="{7AEB8E9C-4E6E-45EB-802A-3F6DBDC3D433}">Reg. dauph.</bibl_link>, I, nos 4592 et 4606, c. 765, 767)? L’abbé des 
                <place_name BNE="" BNE_city="" BNF="" BNF_city="" GND="" GND_city="" GS_Klosterdatenbank="" Getty="" LCCN="" LCCN_city="" VIAF="" VIAF_city="" addition="OCist; die Steine der Abtei wurden später für den Bau der Häuser in Les Chambons verwendet" category="Kloster" country="Frankreich" diocese="Vivarium" geo_DEZIMAL_city="" geo_DMS_city="N 45°06′00″ E 3°47′56″" geodata="N 44°37′43″ E 4°03′10″" geodata_region="0" geodata_vague="0" geonames_city="3031520" getty_city="" id="112470219" identification="Abbaye des Chambons" institution="Monasterium S. Mariae de Campis bonis" literature="" region="Auvergne-Rhône-Alpes" uuid="{DA0A235D-FEC2-4885-823B-768FDA883A9C}">Chambons</place_name> aurait-il alors accompagné l’abbé de 
                <place_name VIAF_city="248738316" addition="OCist" category="Kloster" country="Frankreich" diocese="Vienna" geo_DMS_city="N 46° 27′ 49″ E 0° 13′ 51″" geodata="N 44°27′22″ E 5°09′19″" geodata_region="0" geodata_vague="0" id="11049336" identification="Abbaye Notre Dame de Bonnevaux" institution="Abbatia Bonae Vallis" region="Nouvelle-Aquitaine" uuid="{D2B612FC-07D9-444C-B03C-7350B124932E}">Bonnevaux</place_name> à la Curie? Sur la chronologie, voir 
                <bibl_link target="Schludi, Weg nach Anagni" target2="174013" uuid="{D18AF9C7-E90F-48B7-BE85-B2B7B2C492F7}">U. Schludi, Der Weg nach Anagni. Versuch einer Rekonstruktion, dans Mitteilungen des Instituts für Österreichische Geschichtsforschung, 110, 2002</bibl_link>, p. 281–283, 318–328.</pont_reg_main>
        </main_comment_pont>
