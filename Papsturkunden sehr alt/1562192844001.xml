                </place_name>, audit querelam et confirmat concordiam initam inter 
                <place_name addition="OSB, postea Ocist" category="Kloster" geodata="N 42° 34′ 15″ W 6° 43′ 53″" identification="San Salvador de Carracedo" institution="Monasterium s. Salvatoris (postea s. Mariae) de Carraceto">monasteria Carracetesem (Carracedo)</place_name>, 
                <place_name category="Bistum" diocese="Astorga" geodata="N 42°27′32″ W 6°03′22″" id="3129231" identification="Astorga, episc." institution="Episcopatus Asturicensis">Asturicensis</place_name> dioecesis, et 
                <place_name addition="San Claudio de León" category="Klerus" diocese="Legio" geodata="N 42°36′20″ W 5°34′12″" identification="Leon, monasterio San Claudio" institution="monasterium s. Claudii">s. Claudii</place_name> super 
                <place_name category="Kloster" diocese="Legio" geodata="N 42° 32′ 56″ W 5° 28′ 56″" identification="Toldanos, monasterio" institution="monasterium de Toletanus">monasterio de Toletanis (Toldanos)</place_name>, 
                <place_name category="Bistum" diocese="Legio" geodata="N 42°36′00″ W 5°34′13″" id="3118532" identification="Leon, episc." institution="Episcopatus Legionensis">Legionensis dioecesis</place_name>, secesso ab oboedientia 
                <place_name addition="OSB, postea Ocist" category="Kloster" geodata="N 42° 34′ 15″ W 6° 43′ 53″" identification="San Salvador de Carracedo" institution="Monasterium s. Salvatoris (postea s. Mariae) de Carraceto">monasterii de Carraceto</place_name>. Dictum 
                <place_name category="Kloster" diocese="Legio" geodata="N 42° 32′ 56″ W 5° 28′ 56″" identification="Toldanos, monasterio" institution="monasterium de Toletanus">coenobium de Toletanis</place_name> nolebat ingredi in 
                <place_name category="Kloster" identification="monasterio Claravallis">monasterio Clarae Vallis</place_name>, et ascriptum est denique 
                <place_name addition="San Claudio de León" category="Klerus" diocese="Legio" geodata="N 42°36′20″ W 5°34′12″" identification="Leon, monasterio San Claudio" institution="monasterium s. Claudii">monasterio s. Claudii</place_name>. In dicta concordia decernitur quod, in recompensatione, 
                <place_name addition="San Claudio de León" category="Klerus" diocese="Legio" geodata="N 42°36′20″ W 5°34′12″" identification="Leon, monasterio San Claudio" institution="monasterium s. Claudii">monasterium s. Claudii</place_name> debebat tradere 
                <place_name addition="OSB, postea Ocist" category="Kloster" geodata="N 42° 34′ 15″ W 6° 43′ 53″" identification="San Salvador de Carracedo" institution="Monasterium s. Salvatoris (postea s. Mariae) de Carraceto">monasterio Carraceti</place_name>
                <place_name addition="San Claudio de León" category="Klerus" diocese="Legio" geodata="N 42°36′20″ W 5°34′12″" identification="Leon, monasterio San Claudio" institution="monasterium s. Claudii">ecclesiam s. Claudii</place_name> loci de 
                <place_name category="Stadt" diocese="Legio" geodata="N 42° 4′ 59″ W 5° 27′ 0″" identification="Valderas">Valderas</place_name>, 
                <place_name category="Bistum" diocese="Legio" geodata="N 42°36′00″ W 5°34′13″" id="3118532" identification="Leon, episc." institution="Episcopatus Legionensis">Legionensis dioecesis</place_name>.</pont_reg_main>
