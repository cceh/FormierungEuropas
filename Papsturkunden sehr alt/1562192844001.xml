        <main_comment_pont>
            <pont_reg_main nr="Ib. Pont. II 79 n. *1"> De re cf. 
                <bibl_link target="España Sagrada 35">Risco España Sagrada XXXV</bibl_link> 231; 
                <bibl_link>Díaz-Jiménez y Molleda Historia de San Claudio</bibl_link> p. 156sq.; Julio 
                <bibl_link target="González, Collectio canonum ecclesiae">González</bibl_link> Regesta de Fernando II 104; 
                <bibl_link>Domínguez Sánchez San Claudio</bibl_link> p. 12. Videatur insuper quod 
                <bibl_link target="Martínez Martínez, Cartulario Carracedo 1">Martín Martínez Martínez Cartulario de Carracedo</bibl_link> p. 66–67 n. 57, edit aliud instrumentum, ex Cartulario Carracetensi, dat. Zamora a. 1172 iul. 10 (D f. 78 n. 31), in quo legatus 
                <pers_name addition="Hyacinthus Bobo" key="193550312" life="1106-1198" place="Roma" reg="Celestinus III papa">Iacintus</pers_name> recipit 
                <place_name addition="OSB, postea Ocist" category="Kloster" geodata="N 42° 34′ 15″ W 6° 43′ 53″" identification="San Salvador de Carracedo" institution="Monasterium s. Salvatoris (postea s. Mariae) de Carraceto">monasterium Carracetensem</place_name> in protectionem s. 
                <place_name addition="Papa; S. Romana ecclesia" category="Bistum" diocese="Roma" geodata="N 41°53′12″ E 12°30′20″" id="11669597" identification="Roma, sedes apostolica et patriarchatus" institution="Sedes apostolica et episcopatus seu patriarchatus Romanus">Romanae ecclesiae</place_name> et suae, sub annuo censu unius morabetini persolvendo singulis annis in palatio 
                <place_name category="Kirche" diocese="Roma" geodata="N 41°53′09″ E 12°30′21″" id="7602857" identification="Roma, Laterano" institution="Ecclesia s. Iohannis in Laterano">Lateranensi</place_name>. De legatione 
                <pers_name addition="Hyacinthus Bobo" key="193550312" life="1106-1198" place="Roma" reg="Celestinus III papa">cardinalis Iacinti</pers_name> cf. 
                <bibl_link target="Weiß, Legaten">Weiß Legaten</bibl_link> p. 173–203; 
                <bibl_link target="Fleisch, Rom und die Iberische Halbinsel">Fleisch Rom</bibl_link> p. 144–161 cum studiis laudatis; 
                <bibl_link target="Smith, Iberian Legations">Smith Iberian Legations</bibl_link> passim.</pont_reg_main>
        </main_comment_pont>
